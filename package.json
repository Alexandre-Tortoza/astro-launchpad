{
  "name": "astro-launchpad",
  "version": "0.0.0",
  "private": true,
  "description": "Launch editable Astro landing pages at startup speed.",
  "scripts": {
    "dev": "pnpm --filter @astro-launchpad/template-base dev",
    "build": "pnpm --filter './packages/**' build",
    "test": "pnpm --filter './packages/**' test",
    "lint": "pnpm --filter './packages/**' lint",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.3.0"
}
