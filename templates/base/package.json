{
  "name": "@astro-launchpad/template-base",
  "version": "0.0.1",
  "description": "Base Astro template for Astro Launchpad",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro sync && tsc --noEmit",
    "format": "prettier --write .",
    "launchpad:doctor": "npx create-astro-launchpad doctor"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^7.0.10",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.65.0"
  },
  "keywords": [
    "astro",
    "launchpad",
    "template"
  ],
  "license": "AGPL-3.0-only"
}
