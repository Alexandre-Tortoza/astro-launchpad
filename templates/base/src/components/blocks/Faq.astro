---
import type { FaqPayload } from '../../types/blocks';

type Props = FaqPayload;

const { title, description, items } = Astro.props;
---

<section data-block="faq">
  {title && <h2>{title}</h2>}
  {description && <p>{description}</p>}

  {items.map((item) => (
    <details>
      <summary>{item.question}</summary>
      <p>{item.answer}</p>
    </details>
  ))}
</section>
