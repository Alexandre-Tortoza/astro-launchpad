---
import type { FeaturesPayload } from "../../types/blocks";

type Props = FeaturesPayload;

const { title, description, items } = Astro.props;
---

<section data-block="features">
  <header>
    <h2>{title}</h2>
    {description && <p>{description}</p>}
  </header>

  <ul role="list">
    {
      items.map((item) => (
        <li>
          {item.icon && (
            <span aria-hidden="true" class="icon">
              {item.icon}
            </span>
          )}
          <h3>{item.title}</h3>
          {item.description && <p>{item.description}</p>}
          {item.link && (
            <a
              href={item.link.href}
              data-variant={item.link.variant ?? "secondary"}
            >
              {item.link.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>
