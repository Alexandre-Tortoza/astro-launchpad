---
import type { LogoCloudPayload } from '../../types/blocks';

type Props = LogoCloudPayload;

const { title, description, items } = Astro.props;
---

<section data-block="logo-cloud">
  {title && <h2>{title}</h2>}
  {description && <p>{description}</p>}

  <ul role="list">
    {items.map((logo) => (
      <li>
        {logo.url ? (
          <a href={logo.url} rel="noopener noreferrer">
            <img src={logo.src} alt={logo.alt} loading="lazy" />
          </a>
        ) : (
          <img src={logo.src} alt={logo.alt} loading="lazy" />
        )}
      </li>
    ))}
  </ul>
</section>
