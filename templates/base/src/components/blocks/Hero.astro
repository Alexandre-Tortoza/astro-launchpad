---
import type { HeroPayload } from "../../types/blocks";

type Props = HeroPayload;

const {
  title,
  eyebrow,
  description,
  primaryCta,
  secondaryCta,
  image,
  trustText,
} = Astro.props;
---

<section data-block="hero">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="description">{description}</p>}

  {
    (primaryCta || secondaryCta) && (
      <div class="cta-group">
        {primaryCta && (
          <a
            href={primaryCta.href}
            data-variant={primaryCta.variant ?? "primary"}
          >
            {primaryCta.label}
          </a>
        )}
        {secondaryCta && (
          <a
            href={secondaryCta.href}
            data-variant={secondaryCta.variant ?? "secondary"}
          >
            {secondaryCta.label}
          </a>
        )}
      </div>
    )
  }

  {
    image && (
      <img
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
        loading="eager"
      />
    )
  }

  {trustText && <p class="trust">{trustText}</p>}
</section>
