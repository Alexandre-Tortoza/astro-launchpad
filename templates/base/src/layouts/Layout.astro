---
import "../styles/global.css";
import type { SeoMeta, SiteSettings } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  siteSettings?: SiteSettings;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  noindex = false,
  siteSettings,
} = Astro.props;

const siteName =
  siteSettings?.siteName ??
  import.meta.env.PUBLIC_SITE_NAME ??
  "Astro Launchpad";
const defaultDescription =
  siteSettings?.defaultSeo?.description ??
  "Launch editable landing pages at startup speed.";
const defaultOgImage = siteSettings?.defaultSeo?.ogImage;

const pageTitle = title ? `${title} | ${siteName}` : siteName;
const pageDescription = description ?? defaultDescription;
const pageOgImage = ogImage ?? defaultOgImage;
const canonical = canonicalUrl ?? Astro.url.href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {
      pageDescription && (
        <meta property="og:description" content={pageDescription} />
      )
    }
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={siteName} />
    {pageOgImage && <meta property="og:image" content={pageOgImage} />}

    <!-- Twitter Card -->
    <meta
      name="twitter:card"
      content={pageOgImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    {
      pageDescription && (
        <meta name="twitter:description" content={pageDescription} />
      )
    }
    {pageOgImage && <meta name="twitter:image" content={pageOgImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    {
      siteSettings && siteSettings.nav.length > 0 && (
        <header style="max-width:var(--container-width);margin:0 auto;padding:1rem 1.5rem;display:flex;align-items:center;justify-content:space-between;gap:1rem">
          <a
            href="/"
            style="color:inherit;text-decoration:none;font-weight:700"
          >
            {siteName}
          </a>
          <nav aria-label="Primary navigation" style="display:flex;gap:1rem">
            {siteSettings.nav.map((link) => (
              <a href={link.href} style="color:inherit;text-decoration:none">
                {link.label}
              </a>
            ))}
          </nav>
        </header>
      )
    }
    <slot />
  </body>
</html>
