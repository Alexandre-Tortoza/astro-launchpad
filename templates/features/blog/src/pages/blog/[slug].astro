---
import Layout from "../../layouts/Layout.astro";
import { contentProvider } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await contentProvider.getBlogPosts();
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const [post, siteSettings] = await Promise.all([
  contentProvider.getBlogPost(slug),
  contentProvider.getSiteSettings(),
]);

if (!post) return Astro.redirect("/blog");
---

<Layout
  title={post.title}
  description={post.excerpt}
  ogImage={post.coverImage}
  siteSettings={siteSettings}
>
  <main style="max-width: 48rem; margin: 0 auto; padding: 4rem 1.5rem;">
    <a
      href="/blog"
      style="display: inline-block; color: var(--color-accent); text-decoration: none; font-size: 0.875rem; margin-bottom: 2rem;"
    >
      ← Back to blog
    </a>

    {
      post.coverImage && (
        <img
          src={post.coverImage}
          alt={post.title}
          width="800"
          height="400"
          loading="eager"
          style="width: 100%; aspect-ratio: 2/1; object-fit: cover; border-radius: var(--radius-md); margin-bottom: 2rem;"
        />
      )
    }

    <h1
      style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 700; line-height: 1.2; margin-bottom: 1rem;"
    >
      {post.title}
    </h1>

    <div
      style="display: flex; gap: 1rem; align-items: center; color: var(--color-muted-foreground); font-size: 0.875rem; margin-bottom: 2rem;"
    >
      <time datetime={post.date}>
        {
          new Date(post.date).toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </time>
      {post.author && <span>by {post.author}</span>}
      {
        post.tags && post.tags.length > 0 && (
          <div style="display: flex; gap: 0.5rem;">
            {post.tags.map((tag) => (
              <span style="background: var(--color-muted); color: var(--color-muted-foreground); font-size: 0.75rem; padding: 0.125rem 0.5rem; border-radius: var(--radius-sm);">
                {tag}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <article
      style="color: var(--color-foreground); line-height: 1.75; font-size: 1.0625rem; white-space: pre-wrap;"
      set:text={post.content}
    />
  </main>
</Layout>
