---
import Layout from "../../layouts/Layout.astro";
import { contentProvider } from "../../lib/content";

const [posts, siteSettings] = await Promise.all([
  contentProvider.getBlogPosts(),
  contentProvider.getSiteSettings(),
]);
---

<Layout
  title="Blog"
  description={siteSettings.defaultSeo?.description}
  siteSettings={siteSettings}
>
  <main
    style="max-width: var(--container-width); margin: 0 auto; padding: 4rem 1.5rem;"
  >
    <h1
      style="font-family: var(--font-heading); font-size: 2.25rem; font-weight: 700; margin-bottom: 2rem;"
    >
      Blog
    </h1>

    {
      posts.length === 0 && (
        <p style="color: var(--color-muted-foreground);">
          No posts published yet.
        </p>
      )
    }

    <ul
      style="list-style: none; display: flex; flex-direction: column; gap: 2rem;"
    >
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              style="display: block; text-decoration: none; color: inherit;"
            >
              {post.coverImage && (
                <img
                  src={post.coverImage}
                  alt={post.title}
                  width="800"
                  height="400"
                  loading="lazy"
                  style="width: 100%; aspect-ratio: 2/1; object-fit: cover; border-radius: var(--radius-md); margin-bottom: 1rem;"
                />
              )}
              <h2 style="font-family: var(--font-heading); font-size: 1.5rem; font-weight: 600; margin-bottom: 0.5rem;">
                {post.title}
              </h2>
              <div style="display: flex; gap: 1rem; align-items: center; color: var(--color-muted-foreground); font-size: 0.875rem; margin-bottom: 0.75rem;">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  })}
                </time>
                {post.author && <span>by {post.author}</span>}
              </div>
              {post.excerpt && (
                <p style="color: var(--color-muted-foreground);">
                  {post.excerpt}
                </p>
              )}
              {post.tags && post.tags.length > 0 && (
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.75rem;">
                  {post.tags.map((tag) => (
                    <span style="background: var(--color-muted); color: var(--color-muted-foreground); font-size: 0.75rem; padding: 0.25rem 0.5rem; border-radius: var(--radius-sm);">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
