{
  "kind": "collectionType",
  "collectionName": "navigation_items",
  "info": {
    "singularName": "navigation-item",
    "pluralName": "navigation-items",
    "displayName": "Navigation Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "href": {
      "type": "string",
      "required": true
    },
    "group": {
      "type": "enumeration",
      "enum": ["nav", "social", "footer"],
      "required": true,
      "default": "nav"
    },
    "platform": {
      "type": "string"
    },
    "sort": {
      "type": "integer",
      "default": 0
    }
  }
}
