      "required": true
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text"
    },
    "seo_og_image": {
      "type": "string"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.section"
    }
  }
}
